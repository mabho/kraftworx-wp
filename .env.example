DB_NAME='database_name'
DB_USER='database_user'
DB_PASSWORD='database_password'

# Optionally, you can use a data source name (DSN)
# When using a DSN, you can remove the DB_NAME, DB_USER, DB_PASSWORD, and DB_HOST variables
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

# Optional database variables
# DB_HOST='localhost'
# DB_HOST='127.0.0.1' # Use if you encounter mysqli 2002 / socket connection issues
# DB_PREFIX='wp_'

WP_ENV='development'
WP_HOME='http://example.com'
WP_SITEURL="${WP_HOME}/wp"

# Local only: keep Redis disabled while leaving the plugin active.
# Do not set this in remote development or production.
# WP_REDIS_DISABLED=true

# Redis object cache (Cloudways Redis is server-local)
REDIS_HOST='127.0.0.1'
REDIS_PORT='6379'
REDIS_PREFIX=''
REDIS_USERNAME=''
REDIS_PASSWORD=''
REDIS_DATABASE='0'
REDIS_CLIENT='phpredis'

# Transactional email via Mailgun (use a domain sending key or account API key)
MAILGUN_API_KEY=''
MAILGUN_DOMAIN='mg.kraftworx.com'
MAILGUN_REGION='US'
MAILGUN_FROM_EMAIL='no-reply@mg.kraftworx.com'
MAILGUN_FROM_NAME='Kraftworx'

# HubSpot form integration
HUBSPOT_PORTAL_ID='246537367'
HUBSPOT_FORM_GUID='542da681-7ed8-4792-afe0-ff61b3a72f0f'
HUBSPOT_ACCESS_TOKEN=''
# Optional. Defaults to true in production and false elsewhere.
# HUBSPOT_SUBMIT=true

# Debugging (keep disabled in production unless actively diagnosing)
# WP_DEBUG=true
# WP_DEBUG_DISPLAY=false
# WP_DEBUG_LOG='/absolute/path/to/debug.log'
# SCRIPT_DEBUG=true

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
