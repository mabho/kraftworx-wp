{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "*.env.example*": "allow",
      "*git commit*": "deny",
      "*git push*": "deny",
      "*git tag*": "deny",
      "*gh pr create*": "deny",
      "*gh pr merge*": "deny"
    }
  }
}
