#!/usr/bin/env sh

msg_file="$1"
first_line=$(head -n 1 "$msg_file" | sed 's/[[:space:]]*$//')

if ! printf '%s' "$first_line" | grep -Eq '^[fb]/[0-9]{4}: .+\.$'; then
  echo "Invalid commit message: '$first_line'" >&2
  echo "Required format: f/NNNN: <message>." >&2
  echo "Example: f/0001: Add section block." >&2
  exit 1
fi

exit 0
