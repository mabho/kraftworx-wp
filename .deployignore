# DeployHQ exclusions for the Bedrock application root.
# Frontend build runs in DeployHQ; Composer dependencies and WordPress core are generated on the server.

# Repository and local development
.git
.git/**
.github
.github/**
.ddev
.ddev/**
.vscode
.vscode/**
.githooks
.githooks/**
.deployignore
.gitignore
**/.gitignore
**/.DS_Store
.DS_Store
**/.gitkeep
**/*.log
**/*.map

# Local documentation and tooling
AGENTS.md
README.md
library
library/**
tests
tests/**
opencode.json
phpunit.xml*
pint.json
wp-cli.yml
.phpunit.result.cache
.phpunit.cache
_databases
_databases/**

# Environment and credentials
.env
.env.*
**/.env
**/.env.*
auth.json

# Theme development tooling
web/app/themes/sage-kraftworx/.editorconfig
web/app/themes/sage-kraftworx/.gitignore
web/app/themes/sage-kraftworx/README.md
web/app/themes/sage-kraftworx/node_modules
web/app/themes/sage-kraftworx/node_modules/**
web/app/themes/sage-kraftworx/public/hot

# Composer-generated runtime dependencies; created on the server during After Changes
vendor
vendor/**
web/app/themes/sage-kraftworx/vendor
web/app/themes/sage-kraftworx/vendor/**
web/wp
web/wp/**
web/app/plugins
web/app/plugins/**

# DeployHQ frontend build inputs; public/build is uploaded as the deployment artifact
web/app/themes/sage-kraftworx/package.json
web/app/themes/sage-kraftworx/package-lock.json
web/app/themes/sage-kraftworx/vite.config.js
web/app/themes/sage-kraftworx/resources/css
web/app/themes/sage-kraftworx/resources/css/**
web/app/themes/sage-kraftworx/resources/js
web/app/themes/sage-kraftworx/resources/js/**
web/app/themes/sage-kraftworx/resources/fonts
web/app/themes/sage-kraftworx/resources/fonts/**
web/app/themes/sage-kraftworx/resources/images
web/app/themes/sage-kraftworx/resources/images/**

# Breeze generated configuration and URL index
web/app/breeze-config
web/app/breeze-config/**

# WordPress runtime/cache/uploads should not be overwritten from the repository
web/app/cache/*
web/app/upgrade
web/app/upgrade/**
web/app/uploads/*
web/app/themes/twentytwentyfive
web/app/themes/twentytwentyfive/**
