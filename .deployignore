# DeployHQ exclusions for the Bedrock application root.
# Build inputs are deployed; runtime dependencies, WordPress core, and public/build are generated on the server.

# Repository and local development
.git
.git/**
.github
.github/**
.ddev
.ddev/**
.vscode
.vscode/**
.githooks
.githooks/**
.deployignore
.gitignore
**/.gitignore
**/.DS_Store
.DS_Store
**/.gitkeep
**/*.log
**/*.map

# Local documentation and tooling
AGENTS.md
README.md
library
library/**
tests
tests/**
opencode.json
phpunit.xml*
pint.json
wp-cli.yml
.phpunit.result.cache
.phpunit.cache
_databases
_databases/**

# Environment and credentials
.env
.env.*
**/.env
**/.env.*
auth.json

# Theme development tooling
web/app/themes/sage-kraftworx/.editorconfig
web/app/themes/sage-kraftworx/.gitignore
web/app/themes/sage-kraftworx/README.md
web/app/themes/sage-kraftworx/node_modules
web/app/themes/sage-kraftworx/node_modules/**
web/app/themes/sage-kraftworx/public/hot

# Composer-generated runtime dependencies; created on the server during Before Release Link
vendor
vendor/**
web/app/themes/sage-kraftworx/vendor
web/app/themes/sage-kraftworx/vendor/**
web/wp
web/wp/**
web/app/plugins
web/app/plugins/**

# Server build output; generated during Before Release Link
web/app/themes/sage-kraftworx/public/build
web/app/themes/sage-kraftworx/public/build/**

# WordPress runtime/cache/uploads should not be overwritten from the repository
web/app/cache/*
web/app/upgrade
web/app/upgrade/**
web/app/uploads/*
web/app/themes/twentytwentyfive
web/app/themes/twentytwentyfive/**
