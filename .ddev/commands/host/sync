#!/usr/bin/env bash

## Description: Sync the Cloudways database and/or uploads to local
## Usage: sync [dev|test|live] [--files|--files-only]
## Example: "ddev sync dev --files"
## Flags: [{"Name":"files","Usage":"Sync uploads from remote to local"},{"Name":"files-only","Usage":"Sync uploads only, without the database"}]

# Abort if anything fails
set -e

# Helpers ---------------------------------------------------------------------

red='\033[0;31m'
green='\033[0;32m'
green_bg='\033[42m'
yellow='\033[1;33m'
NC='\033[0m'

# Cloudways host --------------------------------------------------------------

# Use an SSH alias from ~/.ssh/config, for example:
#
# Host kraftworx-cloudways
#   HostName <server-ip>
#   User <cloudways-ssh-user>
#   Port 22
#
# Override the alias with:
#   KRAFTWORX_SYNC_HOST=my-alias ddev sync dev
REMOTE_HOST="${KRAFTWORX_SYNC_HOST:-kraftworxDev}"
SERVER_ID="1683675"

# Non-interactive SSH options. `accept-new` trusts a host on first connection
# without prompting, but still rejects a changed host key.
SSH_OPTS=(
  -T
  -o StrictHostKeyChecking=accept-new
  -o BatchMode=yes
  -o ConnectTimeout=15
)
RSYNC_SSH="ssh -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=15"

# Execution -------------------------------------------------------------------

env=dev
sync_database=true
sync_files=false

if [ "$1" = "--files" ]; then
  sync_files=true
elif [ "$1" = "--files-only" ]; then
  sync_files=true
  sync_database=false
else
  env="${1:-$env}"

  if [[ "$env" != "dev" && "$env" != "test" && "$env" != "live" ]]; then
    echo -e "${red}Invalid environment. Use dev, test, or live.${NC}"
    exit 1
  fi

  if [ "$2" = "--files" ]; then
    sync_files=true
  elif [ "$2" = "--files-only" ]; then
    sync_files=true
    sync_database=false
  fi
fi

# Environment paths -----------------------------------------------------------

case "$env" in
  dev)
    FOLDER_NAME="jcbgukfpnp"
    ;;
  test)
    FOLDER_NAME=""
    ;;
  live)
    FOLDER_NAME=""
    ;;
esac

if [ -z "$FOLDER_NAME" ]; then
  echo -e "${red}The Cloudways application folder for '${env}' is not configured.${NC}"
  echo -e "${yellow}Set FOLDER_NAME in .ddev/commands/host/sync.${NC}"
  exit 1
fi

REMOTE_APP_ROOT="/home/${SERVER_ID}.cloudwaysapps.com/${FOLDER_NAME}"
REMOTE_PUBLIC_PATH="${REMOTE_APP_ROOT}/public_html"
REMOTE_DATABASES_FOLDERPATH="${REMOTE_PUBLIC_PATH}/_databases/"
REMOTE_UPLOADS_FOLDERPATH="${REMOTE_PUBLIC_PATH}/web/app/uploads/"

DATABASE_DUMP_FILENAME="$(date +'%y%m%d-%H%M%S')_kraftworx_${env}"
DATABASE_DUMP_FILENAME_SQL="${DATABASE_DUMP_FILENAME}.sql"
DATABASE_DUMP_FILENAME_TAR="${DATABASE_DUMP_FILENAME}.tar.gz"

LOCAL_DATABASE_FOLDERNAME="./_databases/"
LOCAL_UPLOADS_FOLDERPATH="./web/app/uploads/"

# Database sync ---------------------------------------------------------------

echo -e "${green}Connecting to remote host: ${REMOTE_HOST}${NC}"
echo -e "${green}Cloudways app: ${REMOTE_PUBLIC_PATH}${NC}"

if [ "$sync_database" = true ]; then
  echo -e "${green_bg} Info ${NC}${green} Syncing database from ${env}...${NC}"

  ssh "${SSH_OPTS[@]}" "$REMOTE_HOST" bash -s -- \
    "$REMOTE_PUBLIC_PATH" \
    "$REMOTE_DATABASES_FOLDERPATH" \
    "$DATABASE_DUMP_FILENAME_SQL" \
    "$DATABASE_DUMP_FILENAME_TAR" <<'REMOTE'
set -e

WEB_ROOT="$1"
DATABASES_DIR="$2"
SQL_FILE="$3"
TAR_FILE="$4"
WP_PATH="${WEB_ROOT}/web/wp"

command -v wp >/dev/null 2>&1 || {
  echo "WP-CLI (wp) was not found on the remote server." >&2
  exit 1
}

if ! wp --path="$WP_PATH" core is-installed >/dev/null 2>&1; then
  echo "WP-CLI cannot connect to the remote WordPress database." >&2
  echo "Check the remote .env and database credentials." >&2
  exit 1
fi

mkdir -p "$DATABASES_DIR"

echo "Creating database dump..."
wp --path="$WP_PATH" db export "${DATABASES_DIR}${SQL_FILE}" --add-drop-table < /dev/null

echo "Compressing database dump..."
tar -czf "${DATABASES_DIR}${TAR_FILE}" -C "$DATABASES_DIR" "$SQL_FILE"
REMOTE

  echo -e "${green}Transferring database dump from remote host...${NC}"
  mkdir -p "$LOCAL_DATABASE_FOLDERNAME"
  ssh "${SSH_OPTS[@]}" "$REMOTE_HOST" "cat '${REMOTE_DATABASES_FOLDERPATH}${DATABASE_DUMP_FILENAME_TAR}'" > "${LOCAL_DATABASE_FOLDERNAME}${DATABASE_DUMP_FILENAME_TAR}"

  if [ ! -s "${LOCAL_DATABASE_FOLDERNAME}${DATABASE_DUMP_FILENAME_TAR}" ]; then
    echo -e "${red}The transferred database archive is empty.${NC}"
    exit 1
  fi

  echo -e "${green}Removing the database dump from the remote host...${NC}"
  ssh "${SSH_OPTS[@]}" "$REMOTE_HOST" "rm -f '${REMOTE_DATABASES_FOLDERPATH}${DATABASE_DUMP_FILENAME_TAR}' '${REMOTE_DATABASES_FOLDERPATH}${DATABASE_DUMP_FILENAME_SQL}'"

  echo -e "${yellow}Importing the database into the local environment...${NC}"
  tar -xzvf "${LOCAL_DATABASE_FOLDERNAME}${DATABASE_DUMP_FILENAME_TAR}" -C "$LOCAL_DATABASE_FOLDERNAME"
  ddev import-db --file="${LOCAL_DATABASE_FOLDERNAME}${DATABASE_DUMP_FILENAME_SQL}"

  echo -e "${yellow}Cleaning up the local database dump...${NC}"
  rm -f \
    "${LOCAL_DATABASE_FOLDERNAME}${DATABASE_DUMP_FILENAME_SQL}" \
    "${LOCAL_DATABASE_FOLDERNAME}${DATABASE_DUMP_FILENAME_TAR}"
fi

# Uploads sync ----------------------------------------------------------------

if [ "$sync_files" = true ]; then
  echo -e "${green_bg} Info ${NC}${green} Syncing uploads from ${env}...${NC}"

  mkdir -p "$LOCAL_UPLOADS_FOLDERPATH"
  rsync -avz -e "$RSYNC_SSH" \
    --exclude '.DS_Store' \
    --exclude '*.log' \
    "${REMOTE_HOST}:${REMOTE_UPLOADS_FOLDERPATH}" \
    "$LOCAL_UPLOADS_FOLDERPATH"
else
  echo -e "${green_bg} Info ${NC}${green} Syncing files was not requested...${NC}"
fi
