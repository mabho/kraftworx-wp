#!/usr/bin/env bash

## Description: Download a Cloudways database dump without importing it
## Usage: db-dump [dev|test|prod]
## Example: "ddev db-dump dev"

set -e

red='\033[0;31m'
green='\033[0;32m'
green_bg='\033[42m'
yellow='\033[1;33m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/sync-common.sh
source "${SCRIPT_DIR}/../../sync/sync-common.sh"

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "Usage: ddev db-dump [dev|test|prod]"
  echo "Download a Cloudways database dump without importing it."
  exit 0
fi

requested_env="${1:-dev}"

case "$requested_env" in
  dev|test)
    env="$requested_env"
    ;;
  prod)
    if kw_environment_exists "prod"; then
      env="prod"
    else
      env="live"
    fi
    ;;
  live)
    env="live"
    ;;
  *)
    echo -e "${red}Invalid environment. Use dev, test, or prod.${NC}"
    exit 1
    ;;
esac

kw_load_environment "$env" || exit 1

REMOTE_HOST="$KW_REMOTE_HOST"
REMOTE_PUBLIC_PATH="$KW_REMOTE_PUBLIC_PATH"
REMOTE_WP_PATH="$KW_REMOTE_WP_PATH"
REMOTE_DATABASES_FOLDERPATH="${KW_REMOTE_DATABASE_PATH}/"

DATABASE_DUMP_FILENAME="$(date +'%y%m%d-%H%M%S')_kraftworx_${requested_env}"
DATABASE_DUMP_FILENAME_SQL="${DATABASE_DUMP_FILENAME}.sql"
DATABASE_DUMP_FILENAME_GZ="${DATABASE_DUMP_FILENAME_SQL}.gz"

LOCAL_DATABASE_FOLDERNAME="${KW_LOCAL_DATABASE_PATH}/"
LOCAL_DATABASE_DUMP_PATH="${LOCAL_DATABASE_FOLDERNAME}${DATABASE_DUMP_FILENAME_GZ}"

SSH_OPTS=("${KW_SSH_OPTS[@]}")

echo -e "${green}Connecting to remote host: ${REMOTE_HOST}${NC}"
echo -e "${green}Cloudways app: ${REMOTE_PUBLIC_PATH}${NC}"
echo -e "${green_bg} Info ${NC}${green} Downloading database dump from ${requested_env}...${NC}"

ssh "${SSH_OPTS[@]}" "$REMOTE_HOST" bash -s -- \
  "$REMOTE_WP_PATH" \
  "$REMOTE_DATABASES_FOLDERPATH" \
  "$DATABASE_DUMP_FILENAME_SQL" \
  "$DATABASE_DUMP_FILENAME_GZ" <<'REMOTE'
set -e

WP_PATH="$1"
DATABASES_DIR="$2"
SQL_FILE="$3"
GZ_FILE="$4"

command -v wp >/dev/null 2>&1 || {
  echo "WP-CLI (wp) was not found on the remote server." >&2
  exit 1
}

if ! wp --path="$WP_PATH" core is-installed >/dev/null 2>&1; then
  echo "WP-CLI cannot connect to the remote WordPress database." >&2
  echo "Check the remote .env and database credentials." >&2
  exit 1
fi

mkdir -p "$DATABASES_DIR"

echo "Creating database dump..."
wp --path="$WP_PATH" db export "${DATABASES_DIR}${SQL_FILE}" --add-drop-table < /dev/null

echo "Compressing database dump..."
gzip -f "${DATABASES_DIR}${SQL_FILE}"
REMOTE

echo -e "${green}Transferring database dump from remote host...${NC}"
mkdir -p "$LOCAL_DATABASE_FOLDERNAME"
ssh "${SSH_OPTS[@]}" "$REMOTE_HOST" "cat '${REMOTE_DATABASES_FOLDERPATH}${DATABASE_DUMP_FILENAME_GZ}'" > "$LOCAL_DATABASE_DUMP_PATH"

if [ ! -s "$LOCAL_DATABASE_DUMP_PATH" ]; then
  echo -e "${red}The transferred database dump is empty.${NC}"
  rm -f "$LOCAL_DATABASE_DUMP_PATH"
  exit 1
fi

echo -e "${green}Removing the database dump from the remote host...${NC}"
ssh "${SSH_OPTS[@]}" "$REMOTE_HOST" "rm -f '${REMOTE_DATABASES_FOLDERPATH}${DATABASE_DUMP_FILENAME_GZ}' '${REMOTE_DATABASES_FOLDERPATH}${DATABASE_DUMP_FILENAME_SQL}'"

echo -e "${green_bg} Success ${NC}${green} Database dump saved without importing:${NC}"
echo "  ${LOCAL_DATABASE_DUMP_PATH}"
