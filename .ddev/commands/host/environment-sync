#!/usr/bin/env bash

## Description: Sync a Cloudways database and uploads between environments
## Usage: environment-sync [source..destination] [--db-only|--files-only]
## Example: "ddev environment-sync live..dev"
## Flags: [{"Name":"db-only","Usage":"Sync the database only"},{"Name":"files-only","Usage":"Sync uploads only"}]

set -e

red='\033[0;31m'
green='\033[0;32m'
green_bg='\033[42m'
yellow='\033[1;33m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/sync-common.sh
source "${SCRIPT_DIR}/../../sync/sync-common.sh"

source_env=live
dest_env=dev
sync_database=true
sync_files=true
db_only=false
files_only=false
pair=""

for arg in "$@"; do
  case "$arg" in
    --db-only)
      db_only=true
      ;;
    --files-only)
      files_only=true
      ;;
    -h|--help)
      echo "Usage: ddev environment-sync [source..destination] [--db-only|--files-only]"
      echo "Examples:"
      echo "  ddev environment-sync              # live..dev"
      echo "  ddev environment-sync live..dev"
      echo "  ddev environment-sync dev..live --db-only"
      exit 0
      ;;
    *..*)
      if [ -n "$pair" ]; then
        echo -e "${red}Specify only one source..destination pair.${NC}" >&2
        exit 1
      fi
      pair="$arg"
      ;;
    *)
      echo -e "${red}Invalid argument: ${arg}${NC}" >&2
      exit 1
      ;;
  esac
done

if [ "$db_only" = true ] && [ "$files_only" = true ]; then
  echo -e "${red}--db-only and --files-only cannot be used together.${NC}" >&2
  exit 1
fi

if [ "$db_only" = true ]; then
  sync_files=false
fi

if [ "$files_only" = true ]; then
  sync_database=false
fi

if [ -n "$pair" ]; then
  source_env="${pair%%..*}"
  dest_env="${pair#*..}"
fi

if [ "$source_env" = "$dest_env" ]; then
  echo -e "${red}Source and destination must be different.${NC}" >&2
  exit 1
fi

case "$source_env" in
  dev|test|live) ;;
  *)
    echo -e "${red}Invalid source environment: ${source_env}${NC}" >&2
    exit 1
    ;;
esac

case "$dest_env" in
  dev|test|live) ;;
  *)
    echo -e "${red}Invalid destination environment: ${dest_env}${NC}" >&2
    exit 1
    ;;
esac

# Source -----------------------------------------------------------------------

kw_load_environment "$source_env" || exit 1

SOURCE_ENVIRONMENT="$KW_ENVIRONMENT"
SOURCE_HOST="$KW_REMOTE_HOST"
SOURCE_PUBLIC_PATH="$KW_REMOTE_PUBLIC_PATH"
SOURCE_DATABASE_PATH="$KW_REMOTE_DATABASE_PATH"
SOURCE_UPLOADS_PATH="$KW_REMOTE_UPLOADS_PATH"
SOURCE_WP_PATH="$KW_REMOTE_WP_PATH"
SOURCE_URL="$KW_ENVIRONMENT_URL"

# Destination ------------------------------------------------------------------

kw_load_environment "$dest_env" || exit 1

DEST_ENVIRONMENT="$KW_ENVIRONMENT"
DEST_HOST="$KW_REMOTE_HOST"
DEST_PUBLIC_PATH="$KW_REMOTE_PUBLIC_PATH"
DEST_DATABASE_PATH="$KW_REMOTE_DATABASE_PATH"
DEST_UPLOADS_PATH="$KW_REMOTE_UPLOADS_PATH"
DEST_WP_PATH="$KW_REMOTE_WP_PATH"
DEST_URL="$KW_ENVIRONMENT_URL"
LOCAL_DATABASE_FOLDERNAME="${KW_LOCAL_DATABASE_PATH}/"

SSH_OPTS=("${KW_SSH_OPTS[@]}")
RSYNC_SSH="$KW_RSYNC_SSH"

if [ "$SOURCE_URL" = "" ] || [ "$DEST_URL" = "" ]; then
  echo -e "${red}Source and destination URLs must be configured in .ddev/sync/config.json.${NC}" >&2
  exit 1
fi

echo -e "${green}Source:${NC}      ${SOURCE_ENVIRONMENT} (${SOURCE_URL})"
echo -e "${green}Destination:${NC} ${DEST_ENVIRONMENT} (${DEST_URL})"
echo -e "${green}Database:${NC}    $([ "$sync_database" = true ] && echo yes || echo no)"
echo -e "${green}Uploads:${NC}     $([ "$sync_files" = true ] && echo yes || echo no)"

if [ "$sync_files" = true ]; then
  echo -e "${yellow}Uploads will be replaced exactly (destination-only files are deleted).${NC}"
fi

read -r -p "Continue? [y/N] " confirm

case "$confirm" in
  y|Y|yes|YES) ;;
  *)
    echo "Aborted."
    exit 0
    ;;
esac

# Destination database backup -------------------------------------------------

if [ "$sync_database" = true ]; then
  BACKUP_PREFIX="$(date +'%y%m%d-%H%M%S')_kraftworx_${DEST_ENVIRONMENT}_before_sync"
  BACKUP_SQL="${BACKUP_PREFIX}.sql"
  BACKUP_TAR="${BACKUP_PREFIX}.tar.gz"

  echo -e "${green_bg} Info ${NC}${green} Backing up the destination database...${NC}"

  ssh "${SSH_OPTS[@]}" "$DEST_HOST" bash -s -- \
    "$DEST_WP_PATH" \
    "$DEST_DATABASE_PATH" \
    "$BACKUP_SQL" \
    "$BACKUP_TAR" <<'REMOTE'
set -e

WP_PATH="$1"
DATABASES_DIR="$2"
SQL_FILE="$3"
TAR_FILE="$4"

command -v wp >/dev/null 2>&1 || {
  echo "WP-CLI (wp) was not found on the remote server." >&2
  exit 1
}

mkdir -p "$DATABASES_DIR"

wp --path="$WP_PATH" db export "${DATABASES_DIR}/${SQL_FILE}" --add-drop-table < /dev/null
tar -czf "${DATABASES_DIR}/${TAR_FILE}" -C "$DATABASES_DIR" "$SQL_FILE"
REMOTE

  mkdir -p "$LOCAL_DATABASE_FOLDERNAME"
  ssh "${SSH_OPTS[@]}" "$DEST_HOST" "cat '${DEST_DATABASE_PATH}/${BACKUP_TAR}'" > "${LOCAL_DATABASE_FOLDERNAME}${BACKUP_TAR}"

  if [ ! -s "${LOCAL_DATABASE_FOLDERNAME}${BACKUP_TAR}" ]; then
    echo -e "${red}The destination database backup is empty.${NC}" >&2
    exit 1
  fi

  ssh "${SSH_OPTS[@]}" "$DEST_HOST" "rm -f '${DEST_DATABASE_PATH}/${BACKUP_TAR}' '${DEST_DATABASE_PATH}/${BACKUP_SQL}'"

  echo -e "${green}Backup saved:${NC} ${LOCAL_DATABASE_FOLDERNAME}${BACKUP_TAR}"
fi

# Uploads ---------------------------------------------------------------------

UPLOADS_STAGING=""

cleanup() {
  if [ -n "$UPLOADS_STAGING" ] && [ -d "$UPLOADS_STAGING" ]; then
    rm -rf "$UPLOADS_STAGING"
  fi
}

trap cleanup EXIT

if [ "$sync_files" = true ]; then
  echo -e "${green_bg} Info ${NC}${green} Mirroring uploads from ${SOURCE_ENVIRONMENT} to ${DEST_ENVIRONMENT}...${NC}"

  UPLOADS_STAGING="$(mktemp -d "${TMPDIR:-/tmp}/kraftworx-environment-sync.XXXXXX")"
  ssh "${SSH_OPTS[@]}" "$DEST_HOST" "mkdir -p '${DEST_UPLOADS_PATH}'"

  rsync -a -e "$RSYNC_SSH"     --exclude '.DS_Store'     --exclude '*.log'     "${SOURCE_HOST}:${SOURCE_UPLOADS_PATH}/"     "${UPLOADS_STAGING}/"

  rsync -a --delete -e "$RSYNC_SSH"     --exclude '.DS_Store'     --exclude '*.log'     "${UPLOADS_STAGING}/"     "${DEST_HOST}:${DEST_UPLOADS_PATH}/"
fi

# Database --------------------------------------------------------------------

if [ "$sync_database" = true ]; then
  SOURCE_DUMP_PREFIX="$(date +'%y%m%d-%H%M%S')_kraftworx_${SOURCE_ENVIRONMENT}_for_${DEST_ENVIRONMENT}"
  SOURCE_SQL="${SOURCE_DUMP_PREFIX}.sql"
  SOURCE_TAR="${SOURCE_DUMP_PREFIX}.tar.gz"
  DEST_REMOTE_SQL="${SOURCE_SQL}"

  echo -e "${green_bg} Info ${NC}${green} Exporting the source database...${NC}"

  ssh "${SSH_OPTS[@]}" "$SOURCE_HOST" bash -s -- \
    "$SOURCE_WP_PATH" \
    "$SOURCE_DATABASE_PATH" \
    "$SOURCE_SQL" \
    "$SOURCE_TAR" <<'REMOTE'
set -e

WP_PATH="$1"
DATABASES_DIR="$2"
SQL_FILE="$3"
TAR_FILE="$4"

command -v wp >/dev/null 2>&1 || {
  echo "WP-CLI (wp) was not found on the remote server." >&2
  exit 1
}

if ! wp --path="$WP_PATH" core is-installed >/dev/null 2>&1; then
  echo "WP-CLI cannot connect to the source WordPress database." >&2
  exit 1
fi

mkdir -p "$DATABASES_DIR"

wp --path="$WP_PATH" db export "${DATABASES_DIR}/${SQL_FILE}" --add-drop-table < /dev/null
tar -czf "${DATABASES_DIR}/${TAR_FILE}" -C "$DATABASES_DIR" "$SQL_FILE"
REMOTE

  mkdir -p "$LOCAL_DATABASE_FOLDERNAME"
  ssh "${SSH_OPTS[@]}" "$SOURCE_HOST" "cat '${SOURCE_DATABASE_PATH}/${SOURCE_TAR}'" > "${LOCAL_DATABASE_FOLDERNAME}${SOURCE_TAR}"

  if [ ! -s "${LOCAL_DATABASE_FOLDERNAME}${SOURCE_TAR}" ]; then
    echo -e "${red}The source database dump is empty.${NC}" >&2
    exit 1
  fi

  ssh "${SSH_OPTS[@]}" "$SOURCE_HOST" "rm -f '${SOURCE_DATABASE_PATH}/${SOURCE_TAR}' '${SOURCE_DATABASE_PATH}/${SOURCE_SQL}'"

  tar -xzf "${LOCAL_DATABASE_FOLDERNAME}${SOURCE_TAR}" -C "$LOCAL_DATABASE_FOLDERNAME"

  echo -e "${green_bg} Info ${NC}${green} Uploading the database to ${DEST_ENVIRONMENT}...${NC}"

  ssh "${SSH_OPTS[@]}" "$DEST_HOST" "mkdir -p '${DEST_DATABASE_PATH}'"
  ssh "${SSH_OPTS[@]}" "$DEST_HOST" "cat > '${DEST_DATABASE_PATH}/${DEST_REMOTE_SQL}'" < "${LOCAL_DATABASE_FOLDERNAME}${SOURCE_SQL}"

  ssh "${SSH_OPTS[@]}" "$DEST_HOST" bash -s -- \
    "$DEST_WP_PATH" \
    "${DEST_DATABASE_PATH}/${DEST_REMOTE_SQL}" <<'REMOTE'
set -e

WP_PATH="$1"
SQL_FILE="$2"

wp --path="$WP_PATH" db import "$SQL_FILE"
REMOTE

  ssh "${SSH_OPTS[@]}" "$DEST_HOST" "rm -f '${DEST_DATABASE_PATH}/${DEST_REMOTE_SQL}'"

  echo -e "${green_bg} Info ${NC}${green} Replacing the source URL on ${DEST_ENVIRONMENT}...${NC}"
  echo -e "${yellow}  ${SOURCE_URL} -> ${DEST_URL}${NC}"

  ssh "${SSH_OPTS[@]}" "$DEST_HOST" bash -s -- \
    "$DEST_WP_PATH" \
    "$SOURCE_URL" \
    "$DEST_URL" <<'REMOTE'
set -e

WP_PATH="$1"
SOURCE_URL="$2"
DEST_URL="$3"

wp --path="$WP_PATH" search-replace "$SOURCE_URL" "$DEST_URL" \
  --all-tables \
  --precise \
  --recurse-objects \
  --skip-columns=guid
REMOTE

  echo -e "${yellow}Cleaning up local database dumps...${NC}"
  rm -f \
    "${LOCAL_DATABASE_FOLDERNAME}${SOURCE_SQL}" \
    "${LOCAL_DATABASE_FOLDERNAME}${SOURCE_TAR}"

  echo -e "${green_bg} Info ${NC}${green} Clearing destination caches...${NC}"

  ssh "${SSH_OPTS[@]}" "$DEST_HOST" bash -s -- "$DEST_WP_PATH" <<'REMOTE'
set -e

WP_PATH="$1"

wp --path="$WP_PATH" cache flush

if wp --path="$WP_PATH" plugin is-active breeze >/dev/null 2>&1; then
  wp --path="$WP_PATH" breeze purge --cache=all
fi
REMOTE
fi

echo -e "${green_bg} Success ${NC}${green} ${SOURCE_ENVIRONMENT} -> ${DEST_ENVIRONMENT} sync complete.${NC}"
