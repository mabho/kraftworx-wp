# Application
web/app/plugins/*
!web/app/plugins/.gitkeep

# Ignore Composer-installed mu-plugin directories; single-file mu-plugins are tracked intentionally
web/app/mu-plugins/*/
web/app/themes/twentytwentyfive/
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*

# Theme dependencies and generated assets (DeployHQ uploads build output separately)
web/app/themes/sage-kraftworx/node_modules/
web/app/themes/sage-kraftworx/vendor/
web/app/themes/sage-kraftworx/public/build/
web/app/themes/sage-kraftworx/public/hot

# WordPress
web/wp
web/.htaccess
web/wp/.maintenance

# Logs
*.log

# Dotenv
.env
.env.*
!.env.example

# Composer
/vendor
auth.json

# PHPUnit/Pest
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# WP-CLI
wp-cli.local.yml

# System files
.DS_Store

# Not to be tracked.
_databases
